---
import Icon from './Icon.astro';
import { href } from '../lib/url';
import { CONTACT_EMAIL } from '../data/site';
import { EDITIONS } from '../data/editions';

interface Props {
  edition?: string;
  title?: string;
  lead?: string;
}
const { title, lead } = Astro.props;
const contact = CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}` : href('/enterprise/contact/');
const ed = EDITIONS.enterprise;
---

<section class="container-site pt-16">
  <div class="relative overflow-hidden rounded-2xl bg-enterprise-hero px-6 py-12 text-white ring-1 ring-white/10 sm:px-12">
    <div
      class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-[#4f7096] opacity-40 blur-3xl"
      aria-hidden="true"
    />
    <div class="relative max-w-2xl">
      <h2 class="text-2xl font-bold leading-snug sm:text-3xl">{title ?? ed.promise}</h2>
      <p class="mt-3 leading-7 text-white/75">{lead ?? ed.requires}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={contact} class="btn bg-white text-[#111c2e] hover:bg-white/90">
          <Icon name="mail" size={18} />
          预约演示
        </a>
        <a href={href('/enterprise/deployment/')} class="btn border border-white/30 text-white hover:border-white/60">
          看部署与硬件
        </a>
      </div>
    </div>
  </div>
</section>
