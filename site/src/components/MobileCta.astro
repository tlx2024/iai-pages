---
// 窄屏底部转化条：企业版主 CTA，避免在手机上把预约入口收进抽屉里。
import Icon from './Icon.astro';
import { href } from '../lib/url';
---
<aside
  data-mobile-cta
  aria-label="快捷入口"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-bg/95 px-4 pt-3 backdrop-blur sm:hidden"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom))"
>
  <div class="mx-auto flex max-w-6xl items-center gap-3">
    <p class="min-w-0 flex-1 truncate text-xs text-muted">IAI 智能工厂中枢 · 私有化交付</p>
    <a
      href={href('/enterprise/contact/')}
      class="btn btn-enterprise h-10 shrink-0 px-4 text-sm"
    >
      <Icon name="mail" size={16} />
      预约演示
    </a>
  </div>
</aside>
