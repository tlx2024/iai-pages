---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, BRAND } from '../data/site';
import { href, isActive } from '../lib/url';

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <div class="container-site flex h-16 items-center gap-3">
    <a href={href('/')} class="flex shrink-0 items-center gap-2.5" aria-label={`${BRAND.full} 首页`}>
      <Image src={logo} alt="" width={28} height={28} class="size-7" loading="eager" />
      <span class="text-[15px] font-semibold tracking-tight">
        {BRAND.name}
      </span>
    </a>

    <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={href(item.href)}
            class:list={[
              'relative inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm transition-colors hover:text-primary',
              isActive(path, item.href) ? 'font-medium text-ink' : 'text-ink-soft',
            ]}
            aria-current={isActive(path, item.href) ? 'page' : undefined}
          >
            {item.label}
            {isActive(path, item.href) && (
              <span class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-enterprise" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a
        href={href('/enterprise/contact/')}
        class="btn btn-enterprise hidden h-9 px-3.5 text-sm sm:inline-flex"
      >
        <Icon name="mail" size={16} />
        预约演示
      </a>

      <button
        type="button"
        class="grid size-11 place-items-center rounded-lg border border-line text-ink-soft hover:text-primary lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="打开导航"
        data-nav-toggle
      >
        <Icon name="menu" size={18} class="nav-open" />
        <Icon name="close" size={18} class="nav-close hidden" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-line bg-bg lg:hidden" aria-label="主导航（窄屏）">
    <div class="container-site grid gap-4 py-4">
      <ul class="grid grid-cols-2 gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={href(item.href)}
                class:list={[
                  'block rounded-lg px-3 py-2.5 text-[15px]',
                  isActive(path, item.href) ? 'bg-panel-2 font-medium text-ink' : 'text-ink-soft',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="pt-2">
        <a href={href('/enterprise/contact/')} class="btn btn-enterprise w-full justify-center">
          <Icon name="mail" size={16} />
          预约演示
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // 窄屏抽屉菜单切换
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('mobile-nav');
  const mobileCta = document.querySelector<HTMLElement>('[data-mobile-cta]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    menu?.classList.toggle('hidden', !open);
    mobileCta?.classList.toggle('hidden', open);
    btn.querySelector('.nav-open')?.classList.toggle('hidden', open);
    btn.querySelector('.nav-close')?.classList.toggle('hidden', !open);
  });
</script>
