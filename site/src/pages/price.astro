---
import Base from '../layouts/Base.astro';
import EnterpriseHero from '../components/EnterpriseHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { href } from '../lib/url';

const tiers = [
  {
    name: '车间边缘版',
    en: 'Edge Station',
    desc: '面向单工厂产线、单车间现场或特定关键机组的快速落地与评估。',
    features: [
      '单机一体化 Docker Compose 容器编排',
      '连接本地 MES / SCADA / PLC 工业网络',
      '车间级统一本体与不可变执行账本',
      '支持单卡 GPU 运行内网开源模型（vLLM / Ollama）',
      '多岗位协同工作台与本地文件图层解析',
      '标准部署套件与现场交付指导',
    ],
    cta: '预约方案咨询',
  },
  {
    name: '全厂中枢版',
    en: 'Plant Hub',
    featured: true,
    desc: '面向整个厂区的综合智能中枢，多系统互联、多部门协同与全流程审计。',
    features: [
      '高可用多节点容器编排与故障转移',
      '全厂级统一本体建模、跨系统身份对齐',
      '接入 MES、SCADA、ERP、LIMS 与移动审批通道',
      '工业知识切片、向量索引与确定性 Wiki 驾驶舱',
      '高风险动作多级审批流与防篡改审计日志',
      '专属模型推理集群与算力负载均衡',
      '企业级数字证书与客户端签名',
    ],
    cta: '预约现场评估',
  },
  {
    name: '集团定制版',
    en: 'Enterprise Custom',
    desc: '面向多厂区、集团级跨基地统一管理与定制化工业大模型集成。',
    features: [
      '跨厂区分布式部署与分级管控',
      '集团统一资源树、组织架构与 SSO 单点登录',
      '特定工业行业专属本体与专家知识沉淀',
      '定制化技能库开发与专有协议深度对接',
      '高可用架构容灾演练与定制 SLA 保障',
      '专家团队全程驻场实施与架构支持',
    ],
    cta: '联系专属架构师',
  },
];
---

<Base title="方案与服务" description="IAI 企业版私有化交付方案与服务模式：车间边缘版、全厂中枢版与集团定制版。">
  <EnterpriseHero
    eyebrow="Solutions & Pricing"
    title="方案与交付服务"
    lead="IAI 智能工厂中枢按私有化项目交付。根据工厂规模、接入系统数量与部署架构提供定制方案，数据不出厂，无隐性消费。"
    points={['私有化授权', '现场系统联调', '按需架构规划']}
  >
    <a href={href('/enterprise/contact/')} class="btn bg-white text-[#111c2e] hover:bg-white/90">
      <Icon name="mail" size={18} />
      预约演示与报价
    </a>
    <a href={href('/enterprise/deployment/')} class="btn border border-white/30 text-white hover:border-white/60">
      查看部署形态
    </a>
  </EnterpriseHero>

  <section class="container-site mt-12">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <article class:list={['card flex flex-col p-8', tier.featured ? 'border-enterprise ring-1 ring-enterprise' : '']}>
            {tier.featured && (
              <span class="mb-4 w-fit rounded-md bg-enterprise-soft px-2.5 py-1 text-xs font-semibold text-enterprise">
                推荐部署形态
              </span>
            )}
            <h2 class="text-2xl font-bold tracking-tight text-ink">{tier.name}</h2>
            <p class="font-latin text-xs font-medium text-faint">{tier.en}</p>
            <p class="mt-4 text-[15px] leading-7 text-ink-soft">{tier.desc}</p>
            
            <div class="mt-6 border-t border-line-soft pt-6">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">包含能力与交付物</h3>
              <ul class="mt-4 space-y-3">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm leading-6 text-ink-soft">
                    <Icon name="check" size={16} class="mt-1 shrink-0 text-ok" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 pt-4">
              <a href={href('/enterprise/contact/')} class:list={['btn w-full justify-center', tier.featured ? 'btn-enterprise' : 'btn-secondary']}>
                {tier.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="从具体的业务场景开始评估" lead="我们将根据您现有的数字化系统架构与硬件条件，为您出具详尽的软硬件配置清单与实施排期。" />
</Base>
