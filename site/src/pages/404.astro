---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="页面不存在">
  <section class="container-site flex min-h-[50vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-latin text-6xl font-semibold text-primary">404</p>
    <h1 class="mt-4 text-2xl font-bold">页面不存在</h1>
    <p class="mt-2 text-muted">链接可能已经变更。</p>
    <div class="mt-8 flex gap-3">
      <a href={href('/')} class="btn btn-primary">返回首页</a>
      <a href={href('/docs/')} class="btn btn-secondary">查看文档</a>
    </div>
  </section>
</Base>
