---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { href } from '../lib/url';
import { accountHref } from '../lib/endpoints';
---
<Base title="下载" description="个人版签名安装包即将通过官方域名提供，企业制品通过私有化交付。">
  <section class="container-site pt-14">
    <SectionHeading as="h1" eyebrow="Downloads" title="个人版客户端下载" lead="客户端免费下载，资料与知识库在本机。官方 AI 需要账号和积分，价格以正式发布为准。" />
    <div class="card mt-10 grid gap-8 p-8 md:grid-cols-[1fr_240px]">
      <div>
        <StatusBadge status="planned" />
        <h2 class="mt-4 text-2xl font-semibold">IAI 个人版 · Windows</h2>
        <p class="mt-4 leading-8 text-ink-soft">个人版仍在规划与开发中，邀请内测不开放自助注册。公开签名安装包尚未发布；发布后会展示版本、SHA256、发行签名状态和国内主下载链接。</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <button class="btn btn-primary cursor-not-allowed opacity-60" disabled>Windows 下载 · 尚未发布</button>
          <a class="btn btn-secondary" href={href('/docs/trial/')}>个人版指南</a>
          <a class="btn btn-secondary" href={href('/price/')}>价格说明</a>
        </div>
      </div>
      <dl class="space-y-4 text-sm">
        <div><dt class="text-muted">公开版本</dt><dd class="mt-1">尚未发布</dd></div>
        <div><dt class="text-muted">SHA256</dt><dd class="mt-1">发布时提供</dd></div>
        <div><dt class="text-muted">发行签名</dt><dd class="mt-1">待发行验证</dd></div>
        <div><dt class="text-muted">主下载</dt><dd class="mt-1">官方分发域名，待上线</dd></div>
      </dl>
    </div>
    <div class="card mt-6 flex flex-wrap items-center justify-between gap-6 p-6 sm:p-8"><div><h2 class="text-xl font-semibold">下载之后，连接你的 IAI 账号</h2><p class="mt-2 text-sm leading-7 text-ink-soft">本机知识库免费使用；官方 AI 通过账号与积分提供。可先查看会员方案与账号中心。</p></div><div class="flex flex-wrap gap-3"><a class="btn btn-primary" href={accountHref('register')}>会员注册</a><a class="btn btn-secondary" href={accountHref('account')}>进入账号中心</a></div></div>
    <div class="card mt-8 max-w-3xl p-8">
      <h2 class="text-xl font-semibold">企业私有化交付</h2>
      <p class="mt-4 leading-8 text-ink-soft">服务器套件、企业客户端与镜像包通过私有化项目交付。交付清单、校验和与授权随项目核对。</p>
      <a class="link mt-4 inline-block" href={href('/docs/deployment/')}>查看私有部署说明</a>
    </div>
  </section>
</Base>
