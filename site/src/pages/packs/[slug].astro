---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EditionTag from '../../components/EditionTag.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PACKS, formatBytes, packHref, type Pack } from '../../data/packs';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return PACKS.map((pack) => ({
    params: { slug: pack.slug },
    props: { pack },
  }));
}

interface Props {
  pack: Pack;
}

const { pack } = Astro.props;
const related = PACKS.filter((item) => item.slug !== pack.slug);

const contents = [
  { label: '本体类型', value: `${pack.counts.types} 个`, note: '包含属性、关系与发布检查规则' },
  { label: '示例对象', value: `${pack.counts.examples} 个`, note: '全部带〔示例〕标记，可清理与恢复' },
  { label: '构建问题', value: `${pack.counts.questions} 个`, note: '装包后进入本体工坊的构建列表' },
  { label: '测试文章 / 出处', value: `${pack.counts.sources} 篇`, note: '问答引用时可按出处回查' },
  { label: '示例智能体', value: pack.counts.agents ? `${pack.counts.agents} 个` : '无', note: pack.counts.agents ? '随包装入，可在「我的包」查看' : '本包不含智能体模板' },
  { label: '示例驾驶舱', value: pack.counts.cockpits ? `${pack.counts.cockpits} 个` : '无', note: pack.counts.cockpits ? '随示例数据生成' : '本包不含驾驶舱' },
];
---

<Base title={pack.title} description={pack.summary}>
  <section class="container-site pt-6">
    <nav class="text-sm text-muted" aria-label="面包屑">
      <a href={href('/packs/')} class="hover:text-personal">本体市场</a>
      <span class="mx-1.5 text-faint">/</span>
      <span class="text-ink-soft">{pack.title}</span>
    </nav>

    <header class="mt-6 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2">
        <EditionTag edition="personal" label="官方精选 · 随客户端内置" />
        <span class="rounded-full border border-line px-3 py-0.5 text-xs text-muted">{pack.domainLabel}</span>
      </div>
      <p class="eyebrow mt-6">{pack.domainLabel} · Ontology Pack</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{pack.title}</h1>
      <p class="mt-4 text-xl font-medium leading-relaxed text-ink">{pack.subtitle}</p>
      <p class="mt-4 text-base leading-8 text-ink-soft">{pack.summary}</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {pack.tags.map((tag) => (
          <li class="rounded-md border border-line bg-panel px-2.5 py-1 text-xs text-muted">{tag}</li>
        ))}
      </ul>
    </header>
  </section>

  <div class="container-site mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
    <article class="min-w-0">
      <section class="card overflow-hidden" aria-labelledby="manifest-title">
        <div class="border-b border-line/60 bg-panel-2 px-6 py-5">
          <h2 id="manifest-title" class="text-xl font-bold">包内容概览</h2>
          <p class="mt-1 text-sm text-muted">{pack.industryName}</p>
        </div>
        <dl class="grid grid-cols-2 divide-x divide-y divide-line/60 sm:grid-cols-3">
          <div class="p-5">
            <dt class="text-xs text-muted">类型</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.types}</dd>
          </div>
          <div class="p-5">
            <dt class="text-xs text-muted">示例对象</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.examples}</dd>
          </div>
          <div class="p-5">
            <dt class="text-xs text-muted">文章 / 出处</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.sources}</dd>
          </div>
          <div class="p-5">
            <dt class="text-xs text-muted">构建问题</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.questions}</dd>
          </div>
          <div class="p-5">
            <dt class="text-xs text-muted">智能体</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.agents}</dd>
          </div>
          <div class="p-5">
            <dt class="text-xs text-muted">驾驶舱</dt>
            <dd class="mt-1 text-3xl font-bold tabular-nums">{pack.counts.cockpits}</dd>
          </div>
        </dl>
      </section>

      <section class="mt-12" aria-labelledby="about-title">
        <h2 id="about-title" class="text-2xl font-bold tracking-tight">这个包装了什么</h2>
        <div class="mt-4 space-y-4">
          {pack.description.map((paragraph) => (
            <p class="text-[15px] leading-8 text-ink-soft">{paragraph}</p>
          ))}
        </div>
      </section>

      <section class="mt-12" aria-labelledby="highlights-title">
        <h2 id="highlights-title" class="text-2xl font-bold tracking-tight">亮点</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {pack.highlights.map((item) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-line bg-panel px-4 py-3 text-sm leading-6 text-ink-soft">
              <Icon name="check" size={15} class="mt-0.5 shrink-0 text-personal" />
              {item}
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="contents-title">
        <h2 id="contents-title" class="text-2xl font-bold tracking-tight">包内清单</h2>
        <ul class="mt-5 divide-y divide-line overflow-hidden rounded-xl border border-line">
          {
            contents.map((item) => (
              <li class="grid gap-1 bg-panel px-5 py-4 sm:grid-cols-[160px_minmax(0,1fr)] sm:items-center sm:gap-4">
                <span class="text-sm text-muted">{item.label}</span>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-semibold text-ink">{item.value}</span>
                  <span class="text-xs text-faint">{item.note}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="permissions-title">
        <h2 id="permissions-title" class="text-2xl font-bold tracking-tight">权限与数据</h2>
        <div class="card mt-5 p-6">
          <div class="flex items-start gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-personal-soft text-personal">
              <Icon name="shield" size={18} />
            </span>
            <div>
              <h3 class="font-semibold">安装前展示，安装后由你在本机掌控</h3>
              <p class="mt-2 text-sm leading-7 text-ink-soft">
                声明权限：{pack.permissions.length ? pack.permissions.join('、') : '无额外权限码'}。{pack.grantsNote}
              </p>
              <p class="mt-2 text-sm leading-7 text-ink-soft">
                市场只下载内容，不上传你的本体、对象实例、知识库与向量索引。示例对象全部标记为示例数据，可在「我的包」里一键清理或恢复。
              </p>
              <a href={href('/personal/privacy/')} class="link mt-3 inline-flex items-center gap-1 text-sm">
                查看完整出网清单 <Icon name="arrowRight" size={13} />
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-12" aria-labelledby="version-title">
        <h2 id="version-title" class="text-2xl font-bold tracking-tight">版本与更新日志</h2>
        <div class="card mt-5 p-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-md bg-personal-soft px-2.5 py-1 font-latin text-xs font-semibold text-personal">v{pack.version}</span>
            <span class="text-xs text-muted">更新于 {pack.updatedAt}</span>
            <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">许可证 {pack.license}</span>
          </div>
          <p class="mt-4 text-sm leading-7 text-ink-soft">{pack.changelog}</p>
          <div class="mt-4 grid gap-2 border-t border-line/60 pt-4 text-xs text-muted sm:grid-cols-2">
            <p>包体大小 <span class="text-ink">{formatBytes(pack.sizeBytes)}</span></p>
            <p>发布者 <span class="text-ink">{pack.publisher}</span></p>
            <p>兼容客户端 <span class="text-ink">≥ {pack.minApp}</span></p>
            <p>内层格式 <span class="text-ink">{pack.bundleFormat}</span></p>
          </div>
        </div>
      </section>
    </article>

    <aside class="min-w-0">
      <div class="sticky top-24 space-y-4">
        <div class="card p-6">
          <p class="eyebrow">Install</p>
          <h2 class="mt-2 text-xl font-bold">装进个人版</h2>
          <ol class="mt-4 space-y-3 text-sm leading-6 text-ink-soft">
            <li class="flex gap-2.5">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-personal-soft text-[11px] font-bold text-personal">1</span>
              下载并打开个人版客户端
            </li>
            <li class="flex gap-2.5">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-personal-soft text-[11px] font-bold text-personal">2</span>
              左栏进入「本体工坊 → 市场」，搜索「{pack.title}」
            </li>
            <li class="flex gap-2.5">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-personal-soft text-[11px] font-bold text-personal">3</span>
              确认内容与权限后安装，回到构建页查看包内问题
            </li>
          </ol>
          <a href={href('/download/')} class="btn btn-primary mt-5 w-full justify-center">
            <Icon name="download" size={17} />
            申请内测
          </a>
          <p class="mt-3 text-center text-xs leading-5 text-faint">
            当前版本随客户端内置，无需单独下载包文件；在线目录与公开下载将在后续版本开放。
          </p>
        </div>

        <div class="card p-6">
          <h2 class="text-sm font-semibold">安装前先看</h2>
          <dl class="mt-3 space-y-2.5 text-xs">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted">版本</dt>
              <dd class="font-latin text-ink">v{pack.version}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted">包体</dt>
              <dd class="text-ink">{formatBytes(pack.sizeBytes)}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted">许可证</dt>
              <dd class="text-ink">{pack.license}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted">价格</dt>
              <dd class="text-ink">随客户端免费提供</dd>
            </div>
          </dl>
        </div>
      </div>
    </aside>
  </div>

  <section class="container-site pt-20" aria-labelledby="related-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="related-title" class="text-2xl font-bold tracking-tight">再看看其他包</h2>
      <a href={href('/packs/')} class="text-sm font-medium text-personal hover:underline">全部本体包 →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        related.map((item) => (
          <a href={href(packHref(item.slug))} class="card flex items-center gap-4 p-5 transition-colors hover:border-personal">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-personal-soft text-personal">
              <Icon name={item.icon} size={22} />
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold">{item.title}</h3>
              <p class="mt-1 line-clamp-1 text-xs text-muted">{item.subtitle}</p>
            </div>
            <Icon name="arrowRight" size={16} class="shrink-0 text-muted" />
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand
    edition="personal"
    title="先装一个包，再改成自己的样子"
    lead="个人版客户端、内置本体包与本机知识库都不收费；官方 AI 按账号与积分使用。价格以正式发布为准。"
  />
</Base>
