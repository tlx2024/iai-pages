---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/url';
---

<Base title="字体与素材许可" description="IAI 官网使用的字体与素材及其许可。">
  <PageHero
    eyebrow="Licenses"
    title="字体与素材许可"
    badge="素材与许可"
    note="字体 · 画面 · 构建栈"
  />

  <section class="container-site pb-16">
    <div class="max-w-4xl">
      <div class="grid gap-4">
        <section class="card p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-neutral-soft text-ink-soft">
              <Icon name="book" size={18} />
            </span>
            <h2 class="text-lg font-bold">字体</h2>
          </div>
          <ul class="mt-5 space-y-3 text-[15px] leading-7 text-ink-soft">
            <li>
              <strong class="text-ink">Noto Sans SC</strong>：© 2014–2021 Adobe，SIL Open Font License 1.1。本站使用按站内用字裁剪的子集（修改版本）。
              <a class="link" href={href('/fonts/NotoSansSC-OFL.txt')}>许可全文</a>
            </li>
            <li>
              <strong class="text-ink">Inter Tight</strong>：© 2022 The Inter Project Authors，SIL Open Font License 1.1。
              <a class="link" href={href('/fonts/InterTight-OFL.txt')}>许可全文</a>
            </li>
          </ul>
          <p class="mt-4 border-t border-line pt-4 text-sm text-muted">所有字体均由本站自行托管，不从第三方字体服务加载。</p>
        </section>

        <section class="card p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-neutral-soft text-ink-soft">
              <Icon name="play" size={18} />
            </span>
            <h2 class="text-lg font-bold">宣传片与画面</h2>
          </div>
          <p class="prose-site mt-4 text-[15px] leading-8">
            首页的 60 秒宣传片及各功能页的画面，由产品真实界面组件配合演示数据渲染，不含真实客户数据。配乐由程序原创生成，音效为原创程序化音效。
          </p>
        </section>

        <section class="card p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-neutral-soft text-ink-soft">
              <Icon name="layout" size={18} />
            </span>
            <h2 class="text-lg font-bold">站点构建</h2>
          </div>
          <p class="prose-site mt-4 text-[15px] leading-8">本站使用 Astro、Starlight 与 Tailwind CSS 构建（均为 MIT 许可），以静态页面托管在 GitHub Pages。</p>
        </section>
      </div>
    </div>
  </section>
</Base>
