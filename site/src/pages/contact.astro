---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { CONTACT_EMAIL } from '../data/site';
import { href } from '../lib/url';

const topics = [
  { title: '私有部署与服务器版', desc: '评估服务器版、获取镜像包、讨论硬件与模型选型。' },
  { title: '试用反馈', desc: '安装问题、使用中遇到的错误、希望增加的能力。' },
  { title: '安全问题', desc: '发现安全漏洞或数据风险，请优先告诉我们。' },
];
---

<Base title="联系我们" description="咨询 IAI 私有部署、反馈试用问题或报告安全问题。">
  <section class="container-site pt-14">
    <SectionHeading as="h1" eyebrow="Contact" title="联系我们" lead="咨询私有部署、反馈试用问题、报告安全问题，都可以通过下面的方式找到我们。" />
  </section>

  <section class="container-site mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div class="card p-6 sm:p-8">
      <span class="grid size-11 place-items-center rounded-lg bg-primary-soft text-primary">
        <Icon name="mail" size={22} />
      </span>
      <h2 class="mt-5 text-xl font-semibold">邮箱</h2>
      {
        CONTACT_EMAIL ? (
          <p class="mt-2 text-lg">
            <a class="link" href={`mailto:${CONTACT_EMAIL}`}>
              {CONTACT_EMAIL}
            </a>
          </p>
        ) : (
          <p class="mt-2 text-[15px] leading-7 text-ink-soft">联系方式即将公布。</p>
        )
      }
      <p class="mt-6 text-sm leading-6 text-muted">
        来信时可以附上：所在行业与产线规模、希望解决的问题、需要接入的系统（MES / SCADA / ERP 等），以及对部署方式（是否可以联网、是否使用本机模型）的要求。
      </p>
      <p class="mt-3 text-sm leading-6 text-muted">首版官网不提供在线表单，也不收集任何访问数据。</p>
    </div>
    <ul class="space-y-3">
      {
        topics.map((t) => (
          <li class="card p-5">
            <p class="font-medium">{t.title}</p>
            <p class="mt-1 text-sm leading-6 text-muted">{t.desc}</p>
          </li>
        ))
      }
      <li class="px-1 text-sm text-muted">
        常见问题先看<a class="link" href={href('/docs/faq/')}>这里</a>。
      </li>
    </ul>
  </section>
</Base>
