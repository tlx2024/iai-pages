---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EditionTag from '../../components/EditionTag.astro';
import TeamDiagram from '../../components/TeamDiagram.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { AVAILABILITY_LABEL, EDITIONS, type Availability } from '../../data/editions';
import { PACKS, packHref } from '../../data/packs';
import { href } from '../../lib/url';

// 个人版主线：本体 → 团队 → 项目里派活。知识库与出处是团队靠谱的理由，不是首要卖点。
const ed = EDITIONS.personal;

const steps: { title: string; lead: string; points: string[]; status: Availability; note?: string }[] = [
  {
    title: '描述你的工作',
    lead: '不用先学本体论。',
    points: ['一句话说清你在做什么，本机推荐合适的起步包', '推荐在本机完成，不调用模型、不扣积分', '也可以直接从空白开始'],
    status: 'invite',
  },
  {
    title: '起草本体',
    lead: '把散在脑子里和文件里的规矩写下来。',
    points: ['回答 6–12 个通俗引导问题，AI 起草对象、关系与规矩', '生成前先报价（约 3–8 积分），草案进草稿区由你逐条采纳', '保存新版本时自动跑能力问题回归，越改越准'],
    status: 'invite',
  },
  {
    title: '按本体组建团队',
    lead: '本体就是团队的岗位说明书。',
    points: ['按本体里的岗位和委托契约建 AI 成员', '每个成员写清职责与交付物，加入项目后才在项目里出现', '起步包可以自带示例团队，装完就能看到分工'],
    status: 'invite',
    note: '一句话直接生成整支团队：规划中',
  },
  {
    title: '在项目里派活',
    lead: '项目内可行动，项目外不行动。',
    points: ['在项目对话里点名成员派活；AI 推断的派活先出确认卡', '可约定每天、工作日或每周一定时运行', '读写与运行限定在项目根目录内，关键动作由你签批'],
    status: 'invite',
  },
];

const paradigms = [
  {
    pack: 'personal-opc',
    target: '独立研究者 · 个人工作室 · 超级个体',
    team: '虚拟部门 + AI 代理画像 + 委托契约，一个人统领业务与交付；关键决策签批在回路。',
  },
  {
    pack: 'formulation-team',
    target: '实验室 · 材料配方 · 生物试剂研发',
    team: '以配方、实验批次和表征指标为核心；回答严格依据历史实验与批记录，团队成员按需自建。',
  },
  {
    pack: 'contact-lens-factory',
    target: '产线 · 车间 · 质检与设备工程师',
    team: '产线、工位、检测、缺陷与 SOP 对齐到同一套叫法；可把产线映射到数据孪生，团队成员按需自建。',
  },
] as const;

const pillars = [
  {
    icon: 'lock',
    title: '资料留在本机',
    points: ['知识库、文档原件、向量索引与本体都在本机，断网照常工作', '积分用完或登录过期，本地资料照常可用'],
  },
  {
    icon: 'book',
    title: '句句有出处',
    points: ['回答只依据已发布的本体和本地资料，找不到出处会标明', '点开出处即可定位到当时引用的版本和段落'],
  },
  {
    icon: 'ledger',
    title: '花钱先确认',
    points: ['官方 AI 调用前显示报价与预留上限，确认后才预留积分', '流水只记请求编号与 Token 数，不记录问答正文'],
  },
] as const;
---

<Base title="IAI 个人版" description={`${ed.promise}。${ed.lead}`}>
  {/* ---------- 首屏 ---------- */}
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" style="background: var(--hero-glow)" aria-hidden="true"></div>
    <div class="container-site relative pb-14 pt-14 sm:pt-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-2">
          <EditionTag edition="personal" label={ed.status} />
          <span class="rounded-full border border-line px-3 py-0.5 text-xs text-muted">{ed.requires}</span>
        </div>
        <h1 class="mt-6 text-[2.25rem] font-bold leading-[1.2] tracking-tight [&>span]:inline-block sm:text-5xl lg:text-6xl">
          <span>按你的行业建本体，</span><span>再组一支专业 AI 团队</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-ink-soft sm:text-lg">{ed.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={href('/download/')} class="btn btn-primary">
            <Icon name="download" size={18} />
            申请内测
          </a>
          <a href="#packs" class="btn btn-secondary">看起步包</a>
          <a href={href('/personal/how-it-works/')} class="btn text-ink-soft hover:text-primary">
            工作方式 <Icon name="arrowRight" size={14} />
          </a>
        </div>
      </div>

      <div class="mt-14">
        <TeamDiagram />
        <p class="mt-3 text-xs text-muted">示意：一人公司的本体与团队。岗位与成员随你的本体而定。</p>
      </div>
    </div>
  </section>

  {/* ---------- 四步 ---------- */}
  <section class="border-y border-line bg-panel py-16">
    <div class="container-site">
      <SectionHeading eyebrow="How it works" title="从一句话到一支能派活的团队" lead="每一步都可以停下来改。本体变了，再据此调整团队的岗位与分工。" />
      <ol class="mt-10 grid gap-4 md:grid-cols-2">
        {
          steps.map((s, i) => (
            <li class="flex flex-col rounded-xl border border-line bg-bg p-6">
              <div class="flex items-center justify-between gap-2">
                <span class="font-latin text-sm font-semibold tabular-nums text-personal">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-xs text-muted">{AVAILABILITY_LABEL[s.status]}</span>
              </div>
              <h3 class="mt-3 text-xl font-semibold">{s.title}</h3>
              <p class="mt-1 text-sm text-personal">{s.lead}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {s.points.map((p) => (
                  <li class="flex gap-2 text-[15px] leading-6 text-ink-soft">
                    <Icon name="check" size={16} class="mt-1 shrink-0 text-faint" />
                    {p}
                  </li>
                ))}
              </ul>
              {s.note && <p class="mt-4 rounded-md bg-neutral-soft px-2.5 py-1.5 text-xs text-muted">{s.note}</p>}
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm text-muted">
        资料怎么进本机、Wiki 怎么随本体生长、出处怎么定位，见<a class="link" href={href('/personal/how-it-works/')}>工作方式</a>。
      </p>
    </div>
  </section>

  {/* ---------- 起步包 = 团队起点 ---------- */}
  <section id="packs" class="container-site scroll-mt-24 py-16">
    <SectionHeading eyebrow="Starter packs" title="三套起步包，三种团队起点" lead="随客户端内置，安装不需要联网。装进来的是一套本体、示例对象和出处资料；导入后可以任意修改。" />
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {
        paradigms.map((pd) => {
          const p = PACKS.find((x) => x.slug === pd.pack)!;
          return (
            <a href={href(packHref(p.slug))} class="card group flex flex-col p-6 transition-colors hover:border-personal">
              <span class="grid size-10 place-items-center rounded-lg bg-personal-soft text-personal">
                <Icon name={p.icon} size={20} />
              </span>
              <h3 class="mt-5 text-xl font-semibold">{p.title}</h3>
              <p class="mt-1 text-xs font-medium text-personal">{pd.target}</p>
              <p class="mt-3 flex-1 text-[15px] leading-7 text-ink-soft">{pd.team}</p>
              <dl class="mt-5 grid grid-cols-3 gap-2 border-t border-line-soft pt-4 text-center">
                <div>
                  <dt class="text-xs text-muted">类型</dt>
                  <dd class="font-latin text-lg font-semibold tabular-nums">{p.counts.types}</dd>
                </div>
                <div>
                  <dt class="text-xs text-muted">示例对象</dt>
                  <dd class="font-latin text-lg font-semibold tabular-nums">{p.counts.examples}</dd>
                </div>
                <div>
                  <dt class="text-xs text-muted">示例智能体</dt>
                  <dd class="font-latin text-lg font-semibold tabular-nums">{p.counts.agents}</dd>
                </div>
              </dl>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-personal">
                包内清单与安装方式 <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          );
        })
      }
    </div>
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-panel-2 px-6 py-5">
      <p class="text-sm leading-6 text-ink-soft">
        在线目录、公开下载与第三方投稿在后续版本开放；客户端会校验内置包签名。
      </p>
      <a href={href('/packs/')} class="btn btn-secondary">浏览本体市场</a>
    </div>
  </section>

  {/* ---------- 三个承诺 ---------- */}
  <section class="border-t border-line bg-panel py-16">
    <div class="container-site">
      <SectionHeading eyebrow="Why you can trust the team" title="团队靠得住，是因为这三条" />
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          pillars.map((pi) => (
            <article class="rounded-xl border border-line bg-bg p-6">
              <span class="grid size-10 place-items-center rounded-lg bg-personal-soft text-personal">
                <Icon name={pi.icon} size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{pi.title}</h3>
              <ul class="mt-3 space-y-2">
                {pi.points.map((pt) => (
                  <li class="flex gap-2 text-[15px] leading-6 text-ink-soft">
                    <Icon name="check" size={16} class="mt-1 shrink-0 text-faint" />
                    {pt}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a class="link" href={href('/personal/privacy/')}>出网清单：什么会发出去</a>
        <a class="link" href={href('/price/')}>价格与积分规则</a>
      </div>
    </div>
  </section>

  <CtaBand edition="personal" title="从一个起步包开始，组你的第一支 AI 团队" lead="客户端免费，本机功能不依赖账号。内测规则与价格以正式发布为准。" />
</Base>
