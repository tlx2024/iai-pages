---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EditionDoor from '../components/EditionDoor.astro';
import EditionTag from '../components/EditionTag.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { AVAILABILITY_LABEL, EDITIONS, type Availability } from '../data/editions';
import { PACKS, packHref } from '../data/packs';
import { BRAND } from '../data/site';
import { href } from '../lib/url';

// 首页：一句共同做法 + 两扇等重的门，之后两条路径各讲各的。
const personalSteps: { title: string; desc: string; status: Availability; note?: string }[] = [
  { title: '描述你的工作', desc: '一句话说清你在做什么，本机推荐合适的起步包，不调用模型、不扣积分。', status: 'invite' },
  { title: '起草本体', desc: 'AI 按引导问题起草对象、关系和规矩；草案进草稿区，由你逐条采纳。', status: 'invite' },
  {
    title: '组建团队',
    desc: '按本体里的岗位和委托契约建 AI 成员，写清各自职责，再把成员加入项目。',
    status: 'invite',
    note: '一句话直接生成整支团队：规划中',
  },
  { title: '在项目里派活', desc: '在项目里分派任务，关键动作由你签批；答错了回头改本体，团队跟着变准。', status: 'invite' },
];

const foundations = [
  {
    icon: 'book',
    title: '句句有出处',
    desc: '回答里的结论都能点开原文，定位到当时引用的版本与段落；找不到出处会标明。',
    personal: '引用本机资料与 Wiki',
    enterprise: '引用企业知识库，附审核状态',
  },
  {
    icon: 'shield',
    title: '动手先问人',
    desc: '会改动东西的动作先停下等人确认，确认后在原处继续。',
    personal: '项目内可读写，项目外不行动',
    enterprise: '按风险分级审批，角色与领域授权',
  },
  {
    icon: 'ledger',
    title: '每一步都记账',
    desc: '谁让做的、调了什么、花了多少、结果如何，事后能逐步复盘。',
    personal: '积分流水只记请求编号与用量',
    enterprise: '执行账本与审计日志留存',
  },
] as const;
---

<Base>
  {/* ---------- 首屏：共同做法 + 两扇门 ---------- */}
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" style="background: var(--hero-glow)" aria-hidden="true"></div>
    <div class="container-site relative pb-16 pt-14 sm:pt-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">{BRAND.en}</p>
        <h1 class="mt-3 text-[2.25rem] font-bold leading-[1.2] tracking-tight [&>span]:inline-block sm:text-6xl">
          <span>先立规矩，</span><span>再让 AI 干活</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-ink-soft sm:text-lg">
          IAI 用本体把你的业务说清楚：有哪些对象、谁负责什么、按什么标准交付。AI 按它回答、按它分工，每句话都有出处。
        </p>
        <p class="mt-3 text-sm text-muted">一个人用，还是一家企业用，走的是两条不同的路。</p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
        <EditionDoor edition="personal" />
        <EditionDoor edition="enterprise" />
      </div>
    </div>
  </section>

  {/* ---------- 个人路径 ---------- */}
  <section class="border-y border-line bg-panel py-16">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Personal · Ontology to team" title={EDITIONS.personal.promise} lead="本体就是团队的岗位说明书。先把业务里的对象和规矩写清，再按岗位组 AI 成员，派活、签批、留痕都在项目里。">
          <div class="mt-4"><EditionTag edition="personal" label={EDITIONS.personal.status} /></div>
        </SectionHeading>
        <a href={href('/personal/')} class="link inline-flex items-center gap-1 text-sm">
          个人版总览 <Icon name="arrowRight" size={14} />
        </a>
      </div>

      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          personalSteps.map((s, i) => (
            <li class="flex flex-col rounded-xl border border-line bg-bg p-5">
              <div class="flex items-center justify-between gap-2">
                <span class="font-latin text-sm font-semibold tabular-nums text-personal">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-xs text-muted">{AVAILABILITY_LABEL[s.status]}</span>
              </div>
              <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-7 text-ink-soft">{s.desc}</p>
              {s.note && <p class="mt-3 rounded-md bg-neutral-soft px-2.5 py-1.5 text-xs text-muted">{s.note}</p>}
            </li>
          ))
        }
      </ol>

      <div class="mt-8 rounded-xl border border-line bg-bg p-5 sm:p-6">
        <p class="text-sm font-semibold text-ink">三套起步包，三种团队起点</p>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          {
            PACKS.map((p) => (
              <li>
                <a href={href(packHref(p.slug))} class="group flex h-full flex-col rounded-lg border border-line-soft p-4 transition-colors hover:border-personal">
                  <span class="flex items-center gap-2 font-medium text-ink">
                    <Icon name={p.icon} size={16} class="text-personal" />
                    {p.title}
                  </span>
                  <span class="mt-1 text-sm leading-6 text-muted">{p.subtitle}</span>
                  <span class="mt-3 text-xs text-ink-soft">
                    {p.counts.types} 个类型 · {p.counts.examples} 个示例对象 ·{' '}
                    {p.counts.agents ? `${p.counts.agents} 个示例智能体` : '团队由你按岗位创建'}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- 企业生态 ---------- */}
  <section class="container-site py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
      <div>
        <p class="eyebrow eyebrow-enterprise">Enterprise · One ecosystem</p>
        <h2 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-[2.25rem]">{EDITIONS.enterprise.promise}</h2>
        <p class="mt-4 text-base leading-8 text-ink-soft sm:text-lg">{EDITIONS.enterprise.lead}</p>
        <div class="mt-4"><EditionTag edition="enterprise" label={EDITIONS.enterprise.status} /></div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={href('/enterprise/')} class="btn btn-enterprise">
            了解企业版 <Icon name="arrowRight" size={16} />
          </a>
          <a href={href('/enterprise/deployment/')} class="btn btn-secondary">部署与硬件</a>
        </div>
      </div>
      <EcosystemMap />
    </div>
  </section>

  {/* ---------- 共同底座 ---------- */}
  <section class="border-t border-line bg-panel py-16">
    <div class="container-site">
      <SectionHeading
        eyebrow="Same foundation"
        title="两条路，同一套底线"
        lead="不管是一个人的团队还是一整家企业，IAI 都守这三条。下面写清两版分别怎么做到。"
      />
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {
          foundations.map((f) => (
            <article class="flex flex-col rounded-xl border border-line bg-bg p-6">
              <span class="grid size-10 place-items-center rounded-lg bg-panel-2 text-ink-soft">
                <Icon name={f.icon} size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-7 text-ink-soft">{f.desc}</p>
              <dl class="mt-5 grid gap-2 border-t border-line-soft pt-4 text-sm">
                <div class="flex items-baseline gap-3">
                  <dt class="w-14 shrink-0 text-xs font-medium text-personal">个人版</dt>
                  <dd class="text-ink-soft">{f.personal}</dd>
                </div>
                <div class="flex items-baseline gap-3">
                  <dt class="w-14 shrink-0 text-xs font-medium text-enterprise">企业版</dt>
                  <dd class="text-ink-soft">{f.enterprise}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">
        每项能力在两版里的状态逐条列在<a class="link" href={href('/features/')}>能力与版本对照</a>，规划中的能力不代表交付承诺。
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
