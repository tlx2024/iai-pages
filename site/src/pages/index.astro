---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EditionDoor from '../components/EditionDoor.astro';
import EditionTag from '../components/EditionTag.astro';
import EcosystemMap from '../components/EcosystemMap.astro';
import CtaBand from '../components/CtaBand.astro';
import HomeWorkPreview from '../components/HomeWorkPreview.astro';
import { AVAILABILITY_LABEL, EDITIONS, type Availability } from '../data/editions';
import { PACKS, packHref } from '../data/packs';
import { BRAND } from '../data/site';
import { href } from '../lib/url';

// 首页：一句共同做法 + 两扇等重的门，之后两条路径各讲各的。
const personalSteps: { title: string; desc: string; status: Availability; note?: string }[] = [
  { title: '描述你的工作', desc: '一句话说清你在做什么，本机推荐合适的起步包，不调用模型、不扣积分。', status: 'invite' },
  { title: '起草本体', desc: 'AI 按引导问题起草对象、关系和规矩；草案进草稿区，由你逐条采纳。', status: 'invite' },
  {
    title: '组建团队',
    desc: '按本体里的岗位和委托契约建 AI 成员，写清各自职责，再把成员加入项目。',
    status: 'invite',
    note: '一句话直接生成整支团队：规划中',
  },
  { title: '在项目里派活', desc: '在项目里分派任务，关键动作由你签批；答错了回头改本体，团队跟着变准。', status: 'invite' },
];

const foundations = [
  {
    icon: 'book',
    title: '句句有出处',
    desc: '回答里的结论都能点开原文，定位到当时引用的版本与段落；找不到出处会标明。',
    personal: '引用本机资料与 Wiki',
    enterprise: '引用企业知识库，附审核状态',
  },
  {
    icon: 'shield',
    title: '动手先问人',
    desc: '会改动东西的动作先停下等人确认，确认后在原处继续。',
    personal: '项目内可读写，项目外不行动',
    enterprise: '按风险分级审批，角色与领域授权',
  },
  {
    icon: 'ledger',
    title: '每一步都记账',
    desc: '谁让做的、调了什么、花了多少、结果如何，事后能逐步复盘。',
    personal: '积分流水只记请求编号与用量',
    enterprise: '执行账本与审计日志留存',
  },
] as const;
---

<Base>
  {/* ---------- 首屏：共同做法 + 两扇门 ---------- */}
  <section class="home-hero relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" style="background: var(--hero-glow)" aria-hidden="true"></div>
    <div class="container-site relative pb-16 pt-14 sm:pt-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">{BRAND.en} · 从业务规矩到专业协作</p>
        <h1 class="hero-title mt-5 font-bold tracking-tight [&>span]:inline-block">
          <span>先立规矩，</span><span>再让 AI 干活</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-ink-soft sm:text-lg">
          把你的资料、岗位和业务规矩，变成 AI 工作的依据。<br class="hidden sm:block" />从一个人的专业团队，到一家企业的 AI 生态。
        </p>
        <div class="hero-actions mt-8 flex flex-wrap justify-center gap-3">
          <a href="#work-preview" class="btn btn-primary">查看工作示意 <Icon name="arrowRight" size={16} /></a>
          <a href="#editions" class="btn btn-secondary">选择适合的版本</a>
        </div>
        <p class="mt-5 text-xs text-muted">有据可查 · 人工确认 · 全程留痕</p>
      </div>
      <div class="preview-wrap"><HomeWorkPreview /></div>
    </div>
  </section>

  <section id="editions" class="edition-section container-site py-16" aria-labelledby="editions-title">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Your work, your way</p>
        <h2 id="editions-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">从你的工作方式出发</h2>
        <p class="mt-4 text-base leading-8 text-muted">一个人用，还是一家企业用，走的是两条不同的路。</p>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-2">
        <EditionDoor edition="personal" />
        <EditionDoor edition="enterprise" />
      </div>
  </section>

  {/* ---------- 个人路径 ---------- */}
  <section class="personal-section border-y border-line bg-panel py-16">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="01 / Personal" title="把你的经验，变成团队的工作方法" lead="先把业务对象、岗位和规矩写清楚，形成一份本体。再按岗位组建 AI 团队，在项目里分派任务、核对结果。">
          <div class="mt-4"><EditionTag edition="personal" label={EDITIONS.personal.status} /></div>
        </SectionHeading>
        <a href={href('/personal/')} class="link inline-flex items-center gap-1 text-sm">
          个人版总览 <Icon name="arrowRight" size={14} />
        </a>
      </div>

      <ol class="work-steps mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          personalSteps.map((s, i) => (
            <li class="work-step flex flex-col p-5">
              <div class="flex items-center justify-between gap-2">
                <span class="step-number font-latin font-semibold tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-xs text-muted">{AVAILABILITY_LABEL[s.status]}</span>
              </div>
              <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-7 text-ink-soft">{s.desc}</p>
              {s.note && <p class="mt-3 rounded-md bg-neutral-soft px-2.5 py-1.5 text-xs text-muted">{s.note}</p>}
            </li>
          ))
        }
      </ol>

      <div class="starter-packs mt-8">
        <p class="text-sm font-semibold text-ink">不用从零开始，选一套起步包</p>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          {
            PACKS.map((p) => (
              <li>
                <a href={href(packHref(p.slug))} class="starter-card group flex h-full flex-col rounded-lg border border-line p-5 transition-colors hover:border-personal">
                  <span class="flex items-center gap-2 font-medium text-ink">
                    <Icon name={p.icon} size={16} class="text-personal" />
                    {p.title}
                  </span>
                  <span class="mt-1 text-sm leading-6 text-muted">{p.subtitle}</span>
                  <span class="mt-3 text-xs text-ink-soft">
                    {p.counts.types} 个类型 · {p.counts.examples} 个示例对象 ·{' '}
                    {p.counts.agents ? `${p.counts.agents} 个示例智能体` : '团队由你按岗位创建'}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- 企业生态 ---------- */}
  <section class="enterprise-section container-site py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
      <div>
        <p class="eyebrow eyebrow-enterprise">02 / Enterprise</p>
        <h2 class="mt-3 text-3xl font-bold leading-snug tracking-tight sm:text-[2.25rem]">让各个岗位，<br />在同一套规矩下协作</h2>
        <p class="mt-4 text-base leading-8 text-ink-soft sm:text-lg">{EDITIONS.enterprise.lead}</p>
        <div class="mt-4"><EditionTag edition="enterprise" label={EDITIONS.enterprise.status} /></div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={href('/enterprise/')} class="btn btn-enterprise">
            了解企业版 <Icon name="arrowRight" size={16} />
          </a>
          <a href={href('/enterprise/deployment/')} class="btn btn-secondary">部署与硬件</a>
        </div>
      </div>
      <EcosystemMap />
    </div>
  </section>

  {/* ---------- 共同底座 ---------- */}
  <section class="foundation-section border-t border-line bg-panel py-16">
    <div class="container-site">
      <SectionHeading
        eyebrow="03 / Built on trust"
        title="放心交给 AI，决定权仍在你"
        lead="回答能核对，动作先确认，过程可回看。个人版与企业版，守住同样的底线。"
      />
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {
          foundations.map((f) => (
            <article class="trust-card flex flex-col rounded-xl border border-line bg-bg p-6">
              <span class="grid size-10 place-items-center rounded-lg bg-panel-2 text-ink-soft">
                <Icon name={f.icon} size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-7 text-ink-soft">{f.desc}</p>
              <dl class="mt-5 grid gap-2 border-t border-line-soft pt-4 text-sm">
                <div class="flex items-baseline gap-3">
                  <dt class="w-14 shrink-0 text-xs font-medium text-personal">个人版</dt>
                  <dd class="text-ink-soft">{f.personal}</dd>
                </div>
                <div class="flex items-baseline gap-3">
                  <dt class="w-14 shrink-0 text-xs font-medium text-enterprise">企业版</dt>
                  <dd class="text-ink-soft">{f.enterprise}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-muted">
        每项能力在两版里的状态逐条列在<a class="link" href={href('/features/')}>能力与版本对照</a>，规划中的能力不代表交付承诺。
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .home-hero { background: var(--panel); border-bottom: 1px solid var(--line); }
  .home-hero::before { content: ''; position: absolute; inset: 160px 0 0; pointer-events: none; background-image: linear-gradient(to right, var(--line-soft) 1px, transparent 1px); background-size: 48px 100%; mask-image: linear-gradient(transparent, #000 45%, transparent); }
  .hero-title { font-size: clamp(2.15rem, 5vw, 4rem); line-height: 1.25; letter-spacing: -.045em; }
  .hero-actions :global(.btn) { min-height: 46px; padding-inline: 24px; }
  .preview-wrap { margin-top: 72px; }
  .edition-section { scroll-margin-top: 90px; padding-block: 88px; }
  .personal-section, .enterprise-section, .foundation-section { padding-block: 88px; }
  .work-step { border-top: 1px solid var(--line-strong); padding-inline: 0; padding-top: 22px; }
  .step-number { font-size: 32px; line-height: 1; letter-spacing: -.04em; color: var(--primary); }
  .starter-packs { border-top: 1px solid var(--line); padding-top: 28px; }
  .starter-card { background: var(--bg); }
  .trust-card { background: var(--panel); border-width: 0 0 0 1px; border-radius: 0; padding-block: 0; }
  @media (max-width: 640px) {
    .preview-wrap { margin-top: 48px; }
    .edition-section, .personal-section, .enterprise-section, .foundation-section { padding-block: 56px; }
    .work-steps { gap: 24px; }
    .work-step { padding-bottom: 0; }
    .trust-card { margin-top: 12px; }
  }
</style>
