---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StatusLegend from '../../components/StatusLegend.astro';
import CtaBand from '../../components/CtaBand.astro';
import { FEATURES, FEATURE_ICON, EDITION_LABEL, featureHref } from '../../data/features';
import { href } from '../../lib/url';
---

<Base title="功能" description="IAI 的全部能力及其状态：已交付、工程验证中、规划中；以及试用版与服务器版的可用范围。">
  <section class="container-site pt-14">
    <SectionHeading
      as="h1"
      eyebrow="Capabilities"
      title="功能总览"
      lead="下面列出 IAI 的全部能力。每一项都标注了当前状态，以及在试用版和服务器版中是否可用。口径与产品仓库的能力清单一致，规划中的能力不代表交付承诺。"
    />
    <div class="mt-6"><StatusLegend /></div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        FEATURES.map((f) => (
          <a href={href(featureHref(f.slug))} class="card group flex flex-col p-5 transition-colors hover:border-primary">
            <span class="grid size-9 place-items-center rounded-lg bg-primary-soft text-primary">
              <Icon name={FEATURE_ICON[f.slug as keyof typeof FEATURE_ICON]} size={18} />
            </span>
            <h2 class="mt-4 font-semibold">{f.nav}</h2>
            <p class="mt-1.5 flex-1 text-sm leading-6 text-muted">{f.tagline}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-site mt-16" aria-labelledby="matrix">
    <h2 id="matrix" class="text-2xl font-bold tracking-tight">能力与版本对照</h2>
    <p class="mt-2 text-[15px] text-ink-soft">
      “试用版”指公开下载的桌面试用版；未标注版本的能力为平台通用能力。点击功能名查看详情。
    </p>
    <div class="mt-6 overflow-x-auto rounded-xl border border-line bg-panel">
      <table class="w-full min-w-[720px] text-left text-sm">
        <thead class="border-b border-line bg-panel-2 text-xs text-muted">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium">功能</th>
            <th scope="col" class="px-4 py-3 font-medium">能力</th>
            <th scope="col" class="px-4 py-3 font-medium">状态</th>
            <th scope="col" class="px-4 py-3 font-medium">版本</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line-soft">
          {
            FEATURES.map((f) =>
              f.capabilities.map((c, i) => (
                <tr class="align-top">
                  {i === 0 && (
                    <th scope="rowgroup" rowspan={f.capabilities.length} class="border-r border-line-soft px-4 py-3 font-medium">
                      <a href={href(featureHref(f.slug))} class="hover:text-primary">
                        {f.nav}
                      </a>
                    </th>
                  )}
                  <td class="px-4 py-3">
                    <span class="text-ink">{c.title}</span>
                    {c.note && <span class="mt-0.5 block text-xs leading-5 text-muted">{c.note}</span>}
                  </td>
                  <td class="px-4 py-3">
                    <StatusBadge status={c.status} />
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 text-ink-soft">{c.edition ? EDITION_LABEL[c.edition] : '—'}</td>
                </tr>
              )),
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <CtaBand />
</Base>
