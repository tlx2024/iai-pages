---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EditionBadge from '../../components/EditionBadge.astro';
import StatusLegend from '../../components/StatusLegend.astro';
import CtaBand from '../../components/CtaBand.astro';
import { FEATURES, FEATURE_ICON, featureHref, type Feature } from '../../data/features';
import { shotById } from '../../data/shots';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return FEATURES.map((feature, i) => ({
    params: { slug: feature.slug },
    props: { feature, prev: FEATURES[i - 1], next: FEATURES[i + 1] },
  }));
}

interface Props {
  feature: Feature;
  prev?: Feature;
  next?: Feature;
}

const { feature, prev, next } = Astro.props;
const [lead, ...moreShots] = feature.shots.map(shotById);
const path = Astro.url.pathname;
---

<Base title={feature.title} description={`${feature.tagline}${feature.summary}`}>
  <div class="container-site grid gap-10 pt-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14">
    {/* 侧栏：功能目录 */}
    <aside class="hidden lg:block">
      <nav class="sticky top-24" aria-label="功能目录">
        <a href={href('/features/')} class="text-xs font-medium text-muted hover:text-primary">功能总览</a>
        <ul class="mt-3 space-y-0.5">
          {
            FEATURES.map((f) => {
              const active = path.endsWith(featureHref(f.slug));
              return (
                <li>
                  <a
                    href={href(featureHref(f.slug))}
                    class:list={[
                      'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                      active ? 'bg-primary-soft font-medium text-primary' : 'text-ink-soft hover:bg-panel',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    <Icon name={FEATURE_ICON[f.slug as keyof typeof FEATURE_ICON]} size={16} />
                    {f.nav}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </aside>

    <article class="min-w-0">
      <nav class="text-sm text-muted" aria-label="面包屑">
        <a href={href('/features/')} class="hover:text-primary">功能</a>
        <span class="mx-1.5 text-faint">/</span>
        <span class="text-ink-soft">{feature.nav}</span>
      </nav>

      <header class="mt-6 max-w-3xl">
        <p class="eyebrow">{feature.eyebrow}</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{feature.title}</h1>
        <p class="mt-4 text-xl font-medium leading-relaxed text-ink">{feature.tagline}</p>
        <p class="mt-4 text-base leading-8 text-ink-soft">{feature.summary}</p>
      </header>

      {
        lead && (
          <figure class="mt-10">
            <Image
              src={lead.image}
              alt={`宣传片画面：${lead.headline}`}
              widths={[640, 960, 1440]}
              sizes="(min-width: 1280px) 900px, 100vw"
              class="w-full rounded-xl border border-line"
              loading="eager"
            />
            <figcaption class="mt-2 text-xs text-muted">宣传片画面「{lead.headline}」· 产品真实组件与演示数据</figcaption>
          </figure>
        )
      }

      <section class="mt-14" aria-labelledby="caps">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="caps" class="text-2xl font-bold tracking-tight">能力清单</h2>
        </div>
        <div class="mt-4"><StatusLegend /></div>
        <ul class="mt-6 divide-y divide-line overflow-hidden rounded-xl border border-line bg-panel">
          {
            feature.capabilities.map((c) => (
              <li class="grid gap-3 p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-6">
                <div>
                  <h3 class="font-semibold">{c.title}</h3>
                  <p class="mt-1.5 text-[15px] leading-7 text-ink-soft">{c.desc}</p>
                  {c.note && (
                    <p class="mt-2 flex items-start gap-1.5 text-sm leading-6 text-muted">
                      <Icon name="info" size={14} class="mt-1 shrink-0" />
                      {c.note}
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap items-start gap-2 sm:flex-col sm:items-end">
                  <StatusBadge status={c.status} />
                  {c.edition && <EditionBadge edition={c.edition} />}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      {
        moreShots.map((s) => (
          <figure class="mt-12">
            <Image
              src={s.image}
              alt={`宣传片画面：${s.headline}`}
              widths={[640, 960, 1440]}
              sizes="(min-width: 1280px) 900px, 100vw"
              class="w-full rounded-xl border border-line"
            />
            <figcaption class="mt-2 text-xs text-muted">宣传片画面「{s.headline}」· 产品真实组件与演示数据</figcaption>
          </figure>
        ))
      }

      <nav class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="上一个 / 下一个功能">
        {
          prev ? (
            <a href={href(featureHref(prev.slug))} class="card p-5 transition-colors hover:border-primary">
              <span class="text-xs text-muted">上一个</span>
              <span class="mt-1 block font-semibold">{prev.nav}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={href(featureHref(next.slug))} class="card p-5 text-right transition-colors hover:border-primary">
              <span class="text-xs text-muted">下一个</span>
              <span class="mt-1 block font-semibold">{next.nav}</span>
            </a>
          )
        }
      </nav>
    </article>
  </div>

  <CtaBand />
</Base>
